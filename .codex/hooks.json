{
  "description": "Local README payload synchronization and documentation completion reminder.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const f=require('node:fs'),p=require('node:path');let d=process.cwd();for(;;){const j=p.join(d,'package.json');if(f.existsSync(j)&&JSON.parse(f.readFileSync(j,'utf8')).name==='typesafe-minecraft-demo'){require(p.join(d,'scripts/docs-hook.cjs')).main();break;}const n=p.dirname(d);if(n===d){process.stdout.write('{}');break;}d=n;}\"",
            "timeout": 15,
            "statusMessage": "Keeping project documentation current"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const f=require('node:fs'),p=require('node:path');let d=process.cwd();for(;;){const j=p.join(d,'package.json');if(f.existsSync(j)&&JSON.parse(f.readFileSync(j,'utf8')).name==='typesafe-minecraft-demo'){require(p.join(d,'scripts/docs-hook.cjs')).main();break;}const n=p.dirname(d);if(n===d){process.stdout.write('{}');break;}d=n;}\"",
            "timeout": 15,
            "statusMessage": "Keeping project documentation current"
          }
        ]
      }
    ]
  }
}
